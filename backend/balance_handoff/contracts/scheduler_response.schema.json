{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BALANCE synthetic scheduler report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_version",
    "status",
    "context",
    "ml_status",
    "real_measurement_rows",
    "field_validated",
    "proposal_targets_proven",
    "execution_allowed",
    "device_connected",
    "actual_measured",
    "upstream",
    "experiment",
    "observations",
    "child_plan_created",
    "latency",
    "ledger",
    "static_comparison",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "balance-scheduler-replay/0.1"
    },
    "module_version": {
      "const": "1.0-simulation"
    },
    "status": {
      "const": "SIMULATION_REPLAY_COMPLETE"
    },
    "context": {
      "const": "SIMULASI"
    },
    "ml_status": {
      "const": "TRAINED_SYNTHETIC_ONLY"
    },
    "real_measurement_rows": {
      "const": 0
    },
    "field_validated": {
      "const": false
    },
    "proposal_targets_proven": {
      "const": false
    },
    "execution_allowed": {
      "const": false
    },
    "device_connected": {
      "const": false
    },
    "actual_measured": {
      "type": "null"
    },
    "upstream": {
      "type": "object"
    },
    "experiment": {
      "type": "object"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "child_plan_created": {
      "type": "boolean"
    },
    "static_comparison": {
      "type": "object",
      "required": [
        "context",
        "static",
        "adaptive"
      ],
      "properties": {
        "context": {
          "const": "SIMULASI"
        },
        "static": {
          "type": "object"
        },
        "adaptive": {
          "type": "object"
        }
      }
    },
    "latency": {
      "type": "object",
      "required": [
        "target_30s_proven",
        "hardware_latency_measured"
      ],
      "properties": {
        "target_30s_proven": {
          "const": false
        },
        "hardware_latency_measured": {
          "const": false
        },
        "candidate_compute_wall_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "total_replay_compute_wall_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ledger": {
      "type": "object",
      "required": [
        "context",
        "source_start_ml",
        "source_released_ml",
        "source_remaining_ml",
        "in_transit_release_ml",
        "source_balance_ok",
        "zones",
        "plans",
        "events",
        "execution_allowed",
        "actual_measured"
      ],
      "properties": {
        "context": {
          "const": "SIMULASI"
        },
        "source_start_ml": {
          "type": "number",
          "minimum": 0
        },
        "source_released_ml": {
          "type": "number",
          "minimum": 0
        },
        "source_remaining_ml": {
          "type": "number",
          "minimum": 0
        },
        "in_transit_release_ml": {
          "type": "number",
          "minimum": 0
        },
        "source_balance_ok": {
          "const": true
        },
        "zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ledger_zone"
          }
        },
        "plans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/plan"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event_id",
              "kind",
              "context",
              "actual_measured"
            ],
            "properties": {
              "context": {
                "const": "SIMULASI"
              },
              "actual_measured": {
                "type": "null"
              }
            }
          }
        },
        "execution_allowed": {
          "const": false
        },
        "actual_measured": {
          "type": "null"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "required": [
        "order",
        "zone_id",
        "start_s",
        "release_end_s",
        "verification_end_s",
        "release_ml",
        "expected_received_ml",
        "release_flow_assumed_ml_s",
        "travel_delay_assumed_s"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "zone_id": {
          "type": "string",
          "minLength": 1
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "release_end_s": {
          "type": "number",
          "minimum": 0
        },
        "verification_end_s": {
          "type": "number",
          "minimum": 0
        },
        "release_ml": {
          "type": "number",
          "minimum": 0
        },
        "expected_received_ml": {
          "type": "number",
          "minimum": 0
        },
        "release_flow_assumed_ml_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "travel_delay_assumed_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "zone": {
      "type": "object",
      "required": [
        "zone_id",
        "position",
        "need_ml",
        "delivery_efficiency",
        "max_release_ml",
        "received_to_date_ml",
        "history_need_ml",
        "history_deficit_ml",
        "history_known",
        "minimum_received_ml"
      ],
      "properties": {
        "zone_id": {
          "type": "string"
        },
        "position": {
          "enum": [
            "hulu",
            "tengah",
            "hilir"
          ]
        },
        "need_ml": {
          "type": "number",
          "minimum": 0
        },
        "delivery_efficiency": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_release_ml": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "received_to_date_ml": {
          "type": "number",
          "minimum": 0
        },
        "history_need_ml": {
          "type": "number",
          "minimum": 0
        },
        "history_deficit_ml": {
          "type": "number",
          "minimum": 0
        },
        "history_known": {
          "type": "boolean"
        },
        "minimum_received_ml": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ledger_zone": {
      "type": "object",
      "required": [
        "zone_id",
        "frozen_full_cycle_need_ml",
        "initial_simulated_received_credit_ml",
        "simulated_source_released_ml",
        "simulated_received_total_ml",
        "credited_received_ml",
        "simulated_fulfillment_ratio",
        "actual_measured"
      ],
      "properties": {
        "zone_id": {
          "type": "string"
        },
        "frozen_full_cycle_need_ml": {
          "type": "number",
          "minimum": 0
        },
        "initial_simulated_received_credit_ml": {
          "type": "number",
          "minimum": 0
        },
        "simulated_source_released_ml": {
          "type": "number",
          "minimum": 0
        },
        "simulated_received_total_ml": {
          "type": "number",
          "minimum": 0
        },
        "credited_received_ml": {
          "type": "number",
          "minimum": 0
        },
        "simulated_fulfillment_ratio": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "actual_measured": {
          "type": "null"
        }
      },
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "required": [
        "status",
        "slots",
        "start_s",
        "end_s",
        "horizon_end_s",
        "order_policy",
        "one_slot_at_a_time",
        "wait_for_complete_collection",
        "timing_kind",
        "execution_allowed"
      ],
      "properties": {
        "status": {
          "enum": [
            "READY_FOR_SIMULATION",
            "EMPTY"
          ]
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        },
        "horizon_end_s": {
          "type": "number",
          "minimum": 0
        },
        "order_policy": {
          "const": "EARLIEST_DEADLINE_HISTORY_TAIL_ZONE_ID"
        },
        "one_slot_at_a_time": {
          "const": true
        },
        "wait_for_complete_collection": {
          "const": true
        },
        "timing_kind": {
          "const": "ASSUMPTION"
        },
        "execution_allowed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": [
        "cycle_id",
        "version",
        "parent_version",
        "parent_plan_id",
        "trigger_ref",
        "context",
        "execution_allowed",
        "proposal_status",
        "replay_state",
        "cutoff_simulated_s",
        "source_budget_remaining_ml",
        "frozen_cycle_inputs",
        "policy",
        "allocation",
        "schedule",
        "plan_id"
      ],
      "properties": {
        "cycle_id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "parent_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "trigger_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "const": "SIMULASI"
        },
        "execution_allowed": {
          "const": false
        },
        "proposal_status": {
          "const": "SIMULATION_FOR_REVIEW"
        },
        "replay_state": {
          "enum": [
            "CURRENT",
            "SUPERSEDED_IN_REPLAY",
            "COMPLETED_IN_REPLAY"
          ]
        },
        "cutoff_simulated_s": {
          "type": "number",
          "minimum": 0
        },
        "source_budget_remaining_ml": {
          "type": "number",
          "minimum": 0
        },
        "frozen_cycle_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/zone"
          }
        },
        "policy": {
          "type": "object"
        },
        "allocation": {
          "type": "object",
          "required": [
            "optimizer_version",
            "status",
            "zones",
            "execution_allowed"
          ],
          "properties": {
            "optimizer_version": {
              "const": "balance-lp/1.1-candidate"
            },
            "execution_allowed": {
              "const": false
            },
            "zones": {
              "type": "array"
            }
          }
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^sim-plan-[a-f0-9]{24}$"
        }
      },
      "additionalProperties": false
    }
  }
}
